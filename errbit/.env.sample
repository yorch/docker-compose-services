DOMAIN=errbit.yourdomain.com

MONGODB_USERNAME=errbit
# Required. Generate with: openssl rand -hex 24
MONGODB_PASSWORD=

# Mongo Express basic auth (dev overlay only, `--profile mongo-express`).
# The password is required whenever the dev overlay is used.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# Errbit
# https://github.com/errbit/errbit/blob/main/docs/configuration.md#application-parameters

# RAILS_ENV=development
# This will force the app to redirect to https
RAILS_ENV=production

# Required. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Admin created on first start only (see errbit-init in docker-compose.yml)
ERRBIT_ADMIN_EMAIL=admin@domain.com
# Required. Generate with: openssl rand -hex 16
ERRBIT_ADMIN_PASSWORD=
ERRBIT_ADMIN_USER=admin
ERRBIT_CONFIRM_ERR_ACTIONS=true
ERRBIT_USER_HAS_USERNAME=true
ERRBIT_USE_GRAVATAR=true
# ERRBIT_GRAVATAR_DEFAULT=
ERRBIT_EMAIL_FROM=errbit@domain.com

EMAIL_DELIVERY_METHOD=smtp
SMTP_SERVER=mail.domain.com
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=domain.com
SMTP_ENABLE_STARTTLS_AUTO=true

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

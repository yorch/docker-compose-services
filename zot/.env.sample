# Zot itself is configured in config.json, not here - it has no
# environment-variable support. Only the two values compose interpolates live
# in this file.

# Traefik
DOMAIN=zot.example.com

# Host port for the dev overlay. macOS binds 5000 to the AirPlay Receiver
# (System Settings > General > AirDrop & Handoff), so pick another port there.
# The container port stays 5000 either way.
ZOT_HOST_PORT=5000

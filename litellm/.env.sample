DOMAIN=litellm.domain.com

# Database
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm

# LiteLLM
# Your master key for the proxy server. Can use this to send /chat/completion requests etc
LITELLM_MASTER_KEY="sk-1234"
# Can NOT CHANGE THIS ONCE SET - It is used to encrypt/decrypt credentials stored in DB. If value of 'LITELLM_SALT_KEY' changes your models cannot be retrieved from DB
LITELLM_SALT_KEY="sk-XXXXXXXX"
# Allow storing models in DB / adding them through the UI
STORE_MODEL_IN_DB="True"

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

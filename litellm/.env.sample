DOMAIN=litellm.domain.com

# Database
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=

# LiteLLM
# Your master key for the proxy server. Must start with sk-. Used to send
# /chat/completion requests and as the Admin UI login password.
# Generate one with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts/decrypts provider API keys stored in the DB. CANNOT be changed
# after adding a model - changing it makes stored credentials unreadable.
# Generate one with: openssl rand -hex 32
LITELLM_SALT_KEY=
# Allow storing models in DB / adding them through the UI (default True)
STORE_MODEL_IN_DB=True

# Host interface the dev overlay publishes its datastore port on. The default
# keeps it on the loopback address, reachable from this machine only. Set it
# to 0.0.0.0 to reach it from another machine - and note that Docker's own
# iptables rules sit in front of most host firewalls, so that really does
# mean the whole network.
DEV_BIND_IP=127.0.0.1

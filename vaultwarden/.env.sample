VAULTWARDEN_DOMAIN=vaultwarden.domain.com
# Full public URL; defaults to https://${VAULTWARDEN_DOMAIN}.
# Set to http://localhost:8080 for the dev overlay.
# VAULTWARDEN_URL=

# Admin panel (/admin) token as an argon2 hash. Generate with:
#   docker run --rm -it vaultwarden/server:1.37.3 /vaultwarden hash
# The hash contains $, so keep the value single-quoted. Empty disables /admin.
ADMIN_TOKEN=

# Open registration. Keep false on a public vault and invite users from /admin
# (without SMTP, an invited email can register directly).
# SIGNUPS_ALLOWED=false
# INVITATIONS_ALLOWED=true

# Email (optional; needed for invitation emails, 2FA by email, password hints).
# Read directly from this file; set SMTP_HOST and SMTP_FROM together or neither.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Nothing here is needed for the dev overlay - `docker compose -f
# docker-compose.yml -f docker-compose.dev.yml up -d` runs on the defaults
# baked into loki-config.yaml. The Traefik overlay is the strict one: DOMAIN,
# USERNAME and HASHED_PASSWORD are all declared required, so an unfilled copy
# of this file stops with a message naming the variable rather than starting an
# open log store.

# Traefik
DOMAIN=loki.example.com

# Basic auth, applied by the Traefik overlay. Loki has no login of its own, so
# these credentials are the only thing between the internet and your logs.
# Generate the pair with: htpasswd -nbB admin 'your-password'
# USERNAME is the part before the colon, HASHED_PASSWORD everything after it.
#
# Double every $ in the hash. Compose interpolates the values in this file
# before substituting them, so a bcrypt hash pasted verbatim is read as variable
# references and quietly mangled - $2y$05$Nx7... arrives at Traefik as $2y$05$
# with the digest gone, and the only symptom is a login prompt that rejects the
# right password. Whether it corrupts at all depends on the first character of
# the digest, so a hash that worked once is no guarantee the next one will.
#
#   htpasswd -nbB admin 'your-password' | sed 's/\$/$$/g'
#
# Correct, once doubled:
#   HASHED_PASSWORD=$$2y$$05$$Nx7abcdefghijklmnopqrstuv
USERNAME=
HASHED_PASSWORD=

# How long log lines are kept before the compactor deletes them. Accepts Go
# duration strings, so hours are the largest usable unit - 744h is 31 days,
# 2160h is 90 days. Commenting this out falls back to 744h.
LOKI_RETENTION_PERIOD=744h

# debug, info, warn or error. info is the default.
LOKI_LOG_LEVEL=info

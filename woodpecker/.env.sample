# Values left blank below have no safe default. The compose file declares them
# required, so `docker compose up` stops with a message naming the variable
# rather than starting a half-configured instance.

DOMAIN=woodpecker.example.com

# Only needed with docker-compose.grpc.yml, which exposes the gRPC endpoint for
# agents on other hosts. Must be a separate hostname from DOMAIN, and must
# resolve to this server.
GRPC_DOMAIN=woodpecker-grpc.example.com

# Public URL Woodpecker is served from. Must match the host in the GitHub
# OAuth app's callback URL.
# For the dev overlay use: http://localhost:8000
WOODPECKER_HOST=https://woodpecker.example.com

# Shared secret authenticating the agent to the server.
# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# Comma-separated GitHub logins granted admin rights.
WOODPECKER_ADMIN=your-github-username

# Allow any GitHub user to register. Keep false for a private instance.
WOODPECKER_OPEN=false

# GitHub OAuth app: Settings > Developer settings > OAuth Apps > New OAuth App.
# Authorization callback URL must be ${WOODPECKER_HOST}/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

POSTGRES_DB=woodpecker
POSTGRES_USER=woodpecker
POSTGRES_PASSWORD=woodpecker

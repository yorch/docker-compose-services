# Domain for Traefik routing (used by docker-compose.for-traefik.yml)
DOMAIN=taxhacker.example.com

# Image tag. Pinned for reproducibility; bump deliberately.
TAXHACKER_VERSION=0.8.5

# URL the app is reached at - protocol, host and any port, no trailing slash.
# Dev: http://localhost:7331
# Traefik: https://${DOMAIN}
BASE_URL=http://localhost:7331

# Self-hosted mode makes the app skip its own login and go straight to the
# ledger. Behind Traefik that means anyone who reaches the host can read and
# edit your books, so the overlay puts a basic-auth middleware in front and
# refuses to start without it. Set this to false and create a user by hand
# (see docs/self-hosted-public-access.md upstream) if you want TaxHacker's own
# login instead - new signups stay closed either way.
SELF_HOSTED_MODE=true
DISABLE_SIGNUP=true

# Postgres
POSTGRES_DB=taxhacker
POSTGRES_USER=postgres
# Required. Generate with openssl rand -hex 24.
# Must be URL-safe (no @ : / # ?) - it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# Required. Encrypts auth sessions and the AI keys you enter in Settings.
# Generate with openssl rand -hex 32. Rotating it makes stored keys unreadable.
BETTER_AUTH_SECRET=

# LLM providers - all optional. A key set here is offered as the default in
# Settings > AI, where it can be replaced without touching this file.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-medium-latest

# Basic auth for the Traefik overlay (default: admin / taxhacker).
# Generate the hash with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# It contains $ characters, so wrap the value in single quotes here.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=

# Host interface the dev overlay publishes Postgres on. The default keeps it on
# the loopback address, reachable from this machine only. Set it to 0.0.0.0 to
# reach it from another machine - and note that Docker's own iptables rules sit
# in front of most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

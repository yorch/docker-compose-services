# Cron jobs source /etc/cron.env (written at container startup).
#
# Email sync heartbeat - every 5 min; runEmailSync honours each mailbox's UI
# sync frequency. The lock keeps a slow run from overlapping the next tick,
# which would re-read the same watermark and ingest the same mail twice.
*/5 * * * * set -a; . /etc/cron.env; cd /app && flock -n /tmp/email-sync.lock npm run email:sync >> /var/log/cron.log 2>&1

# Rotate the log when it grows past 10 MB.
0 0 * * * find /var/log -name "cron.log*" -size +10M -delete

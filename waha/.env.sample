DOMAIN=waha.example.com

# All required: this API controls a WhatsApp account.
# Sent as the X-Api-Key header. Generate with: openssl rand -hex 32
WAHA_API_KEY=
# Dashboard login (generate the password with: openssl rand -hex 16)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
# Swagger UI login
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

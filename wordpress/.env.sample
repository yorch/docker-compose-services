DOMAIN=wp.example.com

# URL WordPress is installed under on first start. Keep the default for the
# dev overlay; behind Traefik set it to https://${DOMAIN}.
# WP_URL=http://localhost:8080
# WP_TITLE=WordPress

DB_USERNAME=wordpress
# Required. Generate with: openssl rand -hex 24
DB_PASSWORD=
DB_NAME=wordpress
# Required. Generate with: openssl rand -hex 24
DB_ROOT_PASSWORD=

# Admin account created on first start (required)
WP_USERNAME=admin
# Generate with: openssl rand -hex 16
WP_PASSWORD=
WP_EMAIL=admin@example.com

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

CONFIG_URL=https://someurl
INFLUX_TOKEN=12345
INFLUX_HOST=https://host.domain.com
INFLUX_ORG=some-org

# GID of the host's docker group, so telegraf can read /var/run/docker.sock.
# Find it with: getent group docker | cut -d: -f3   (Linux)
# Required - the container runs as `telegraf:${DOCKER_GROUP_ID}`.
DOCKER_GROUP_ID=999

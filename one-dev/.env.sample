DOMAIN=onedev.domain.com

# Admin account created on first start (all required; ignored afterwards)
INITIAL_USER=admin
# Generate with: openssl rand -hex 16
INITIAL_PASSWORD=
INITIAL_EMAIL=
# https://${DOMAIN} behind Traefik, http://localhost:6610 for the dev overlay
INITIAL_SERVER_URL=
# SSH root url of this server (will derive from initial_server_url if left empty)
# INITIAL_SSH_ROOT_URL=

# Host ports for the dev overlay
PORT_WEB=6610
PORT_SSH=6611

# OpenSEO - open-source SEO tool powered by DataForSEO

# Traefik
DOMAIN=openseo.example.com

# Port the container listens on. Also used for the dev overlay host mapping.
PORT=3001

# Required. Base64-encoded DataForSEO API credential. The app has no SEO data
# without it. Get one at https://dataforseo.com/.
# Format: printf '%s' 'YOUR_LOGIN:YOUR_PASSWORD' | base64
DATAFORSEO_API_KEY=

# Hostname the app is served from when behind a reverse proxy. Leave blank for
# local dev. The Traefik overlay sets this to ${DOMAIN} automatically.
ALLOWED_HOST=

# Telemetry disabled by default for privacy. Set to 0 to opt back in.
OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Optional: AI features (SAM, the in-app SEO agent) via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: Google Search Console integration. BETTER_AUTH_SECRET is required
# when using GSC (it encrypts stored OAuth tokens).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with openssl rand -hex 32. Required for Google Search Console.
BETTER_AUTH_SECRET=

# Dev port binding - bind to localhost only (auth is disabled in Docker mode).
# Set to 0.0.0.0 to expose on all interfaces (not recommended).
DEV_BIND_IP=127.0.0.1

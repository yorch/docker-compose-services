DOMAIN=domain.com

# Basic auth in front of the Jaeger UI and HotROD behind Traefik (required there).
# Generate the hash with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Hashes contain $, so keep the value single-quoted.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD_HASH=

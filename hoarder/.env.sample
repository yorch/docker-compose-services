# Recorded by ../mode.sh (or the run-*.sh scripts); example:
# COMPOSE_FILE=docker-compose.yml:docker-compose.for-traefik.yml

DOMAIN=karakeep.domain.com

# Image tag (default 0.33.2)
# KARAKEEP_VERSION=0.33.2

# If enabled, no new signups will be allowed and the signup button will be disabled in the UI
DISABLE_SIGNUPS=false

# Required. Master key for Meilisearch (runs in production mode).
# Generate one with: openssl rand -base64 36
MEILI_MASTER_KEY=

# Required. Random string used to sign the JWT tokens.
# Generate one with: openssl rand -base64 36
NEXTAUTH_SECRET=

# Should point to the address of your server. The app will function without it,
# but will redirect you to wrong addresses on signout for example.
# NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL=https://karakeep.domain.com

# https://docs.karakeep.app/configuration/#inference-configs-for-automatic-tagging
# Optional: enables AI tagging
# OPENAI_API_KEY=
# INFERENCE_TEXT_MODEL=gpt-4o-mini
# INFERENCE_IMAGE_MODEL=gpt-4o-mini
# INFERENCE_CONTEXT_LENGTH=2048

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

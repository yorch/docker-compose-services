DOMAIN=agentlogs.example.com

# https://agentlogs.ai/docs/server/hosting


# Required. Generate with openssl rand -base64 32. Used to sign auth state and sessions.
BETTER_AUTH_SECRET=some-random-secret

# Public base URL of your app. Used for OAuth callbacks, auth origins, and browser redirects. Set this to your real public hostname in production.
WEB_URL=https://agentlogs.example.com

# When enabled, new users default to the waitlist role. Set it to false to make new users regular users immediately.
WAITLIST_ENABLED=true

# Required if GitHub login is enabled. GitHub OAuth app client ID.
GITHUB_CLIENT_ID=your-github-client-id
# Required if GitHub login is enabled. GitHub OAuth app client secret.
GITHUB_CLIENT_SECRET=your-github-client-secret

# Required if GitLab login is enabled. GitLab OAuth/OIDC app client ID.
GITLAB_CLIENT_ID=your-gitlab-client-id
# Required if GitLab login is enabled. GitLab OAuth/OIDC app client secret.
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
# Set this to your self-managed GitLab instance URL when not using gitlab.com.
GITLAB_ISSUER=https://gitlab.com

# Enables transactional email delivery.
RESEND_API_KEY=your-resend-api-key
# Overrides the default transactional sender.
EMAIL_SENDER=Name <name@example.com>

# Enables AI-generated summaries through OpenRouter when no custom AI endpoint is configured.
OPENROUTER_API_KEY=your-openrouter-api-key
# Base URL for an OpenAI-compatible API. Typical values end in /v1.
AI_BASE_URL=
# Required with AI_BASE_URL. Model identifier sent to the compatible endpoint.
AI_MODEL=
# Optional API key for the compatible endpoint. Leave blank for local providers that do not require auth.
AI_API_KEY=

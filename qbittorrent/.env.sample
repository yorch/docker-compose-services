HOST=yourhost.domain.com

# qBittorrent
TZ=Europe/London
# PUID=1000
# PGID=1000
WEBUI_PORT=8080
TORRENTING_PORT=6881

# Gluetun
VPN_SERVICE_PROVIDER=mullvad
# Required for the Gluetun setup: copy both from your provider's WireGuard config
# (use the IPv4 address for WIREGUARD_ADDRESSES)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Choose any available city
# Built-in list of cities: https://raw.githubusercontent.com/qdm12/gluetun/master/internal/storage/servers.json
SERVER_CITIES=Stockholm
# Update the servers information for the currently in-use VPN service provider
# UPDATER_PERIOD=24h

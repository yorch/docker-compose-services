SHLINK_DOMAIN=shlink.domain.com

# Database
POSTGRES_DB=shlink
POSTGRES_USER=shlink
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Required. Admin API key created on first start; enter it in the web client
# together with https://${SHLINK_DOMAIN}. Generate with: openssl rand -hex 32
INITIAL_API_KEY=

# Optional. MaxMind key for visit geolocation; leave empty to disable
GEOLITE_LICENSE_KEY=
IS_HTTPS_ENABLED=true

ANONYMIZE_REMOTE_ADDR=true

# Twenty CRM - self-hosted Salesforce alternative

# Public URL where the server is reachable (include protocol and port if non-standard)
# Dev: http://localhost:3000  Traefik: https://your-domain
SERVER_URL=

# Domain for Traefik routing (used by docker-compose.for-traefik.yml)
DOMAIN=twenty.example.com

# Database
# Postgres user (default postgres)
# PG_DATABASE_USER=postgres
# Postgres host (default db)
# PG_DATABASE_HOST=db
# Postgres port (default 5432)
# PG_DATABASE_PORT=5432
# Postgres database name (default default)
# PG_DATABASE_NAME=default
# Postgres password - REQUIRED. Must be URL-safe (no @ : / # ? etc) because it
# is interpolated into the PG_DATABASE_URL connection string.
PG_DATABASE_PASSWORD=

# Redis URL (default redis://redis:6379)
# REDIS_URL=redis://redis:6379

# Encryption key - REQUIRED, generate with openssl rand -base64 32
ENCRYPTION_KEY=
# Set to the previous ENCRYPTION_KEY during a key rotation (optional)
# FALLBACK_ENCRYPTION_KEY=
# Legacy: only required for instances that pre-date ENCRYPTION_KEY (optional)
# APP_SECRET=

# Storage
# local stores files on disk, s3 uses an S3-compatible bucket
STORAGE_TYPE=local
# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Note: S3 access keys must be set in .env AND are passed to the container
# automatically when STORAGE_TYPE=s3.

# Server flags (default false on server, hardcoded true on worker)
# DISABLE_DB_MIGRATIONS=false
# DISABLE_CRON_JOBS_REGISTRATION=false

# Dev port binding - bind sidecars to localhost only (set to 0.0.0.0 to expose)
# DEV_BIND_IP=127.0.0.1

# Hostname Traefik serves the UI on (Traefik setup only)
DOMAIN=wg-portal.example.com
# Public URL of the UI, used for links and OAuth redirects.
# https://${DOMAIN} behind Traefik; the default suits local access.
# WG_PORTAL_URL=http://localhost:8888

# Admin account, created on first start if it does not exist yet. Required;
# the password must be at least 16 characters or wg-portal refuses to start.
# Generate with: openssl rand -hex 16
WG_PORTAL_ADMIN_USER=admin@wgportal.local
WG_PORTAL_ADMIN_PASSWORD=

# Required web secrets (defaults are `very_secret` / `extremely_secret`).
# Generate each with: openssl rand -hex 32
WG_PORTAL_SESSION_SECRET=
WG_PORTAL_CSRF_SECRET=

# Host interface the UI port 8888 is published on (loopback by default)
UI_BIND_IP=127.0.0.1

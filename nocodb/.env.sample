DOMAIN=nocodb.domain.com

POSTGRES_DB=nocodb
POSTGRES_USER=user
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432

# https://docs.nocodb.com/getting-started/self-hosted/environment-variables/#email-notifications
NC_SMTP_FROM=noreply@domain.com
NC_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
NC_SMTP_PORT=465
NC_SMTP_USERNAME=your_user
NC_SMTP_PASSWORD=your_password
NC_SMTP_SECURE=true
NC_SMTP_IGNORE_TLS=false

# https://docs.nocodb.com/getting-started/self-hosted/environment-variables/#storage
NC_S3_BUCKET_NAME=
NC_S3_REGION=us-east-1
NC_S3_ACCESS_KEY=
NC_S3_ACCESS_SECRET=

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

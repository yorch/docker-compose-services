# Values left blank below have no safe default. The compose file declares them
# required, so `docker compose up` stops with a message naming the variable
# rather than starting a half-configured instance.

# Traefik - public hostname, no scheme or port
DOMAIN=learn.example.com

# Dev overlay only - host port for http://localhost:<port>
DEV_PORT=8080

# Secrets. Generate each with openssl rand -hex 32
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=

# Initial admin and organization, created on first start only. Changing these
# later has no effect - manage accounts from the dashboard instead.
LEARNHOUSE_INITIAL_ADMIN_EMAIL=
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=
LEARNHOUSE_INITIAL_ORG_NAME=Default Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default

POSTGRES_DB=learnhouse
POSTGRES_USER=learnhouse
# Stick to [A-Za-z0-9.~_-] - the password is embedded in a URI unescaped.
# Generate with openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional - AI features. Provider is one of google, openai, anthropic,
# mistral, openrouter, ollama, ...
LEARNHOUSE_IS_AI_ENABLED=False
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
# Google key, also used for embeddings when the provider has none
LEARNHOUSE_GEMINI_API_KEY=

# Optional - email (password resets, invites). Provider is resend or smtp.
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SMTP_HOST=
LEARNHOUSE_SMTP_PORT=587
LEARNHOUSE_SMTP_USERNAME=
LEARNHOUSE_SMTP_PASSWORD=
LEARNHOUSE_SMTP_USE_TLS=True

# Optional - Unsplash access key for the in-editor image picker
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

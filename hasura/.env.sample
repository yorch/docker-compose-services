# Required. Sent as the x-hasura-admin-secret header and asked for by the console.
# Generate with: openssl rand -hex 32
HASURA_GRAPHQL_ADMIN_SECRET=

# Debugging mode (verbose errors). Defaults to false; enable only locally.
# HASURA_GRAPHQL_DEV_MODE=true
# Enable the console served by server
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log
# Uncomment next line to run console offline (i.e load console assets from server instead of CDN)
# HASURA_GRAPHQL_CONSOLE_ASSETS_DIR=/srv/console-assets

# Database
POSTGRES_DB=hasura
POSTGRES_USER=hasura
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

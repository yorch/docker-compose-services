# Dev-only front door, mounted by docker-compose.dev.yml.
#
# The published rybbit-client image resolves the API relative to whatever
# origin serves the dashboard - upstream builds it with an empty
# NEXT_PUBLIC_BACKEND_URL, so the browser bundle ships `baseURL: ""` and calls
# "/api" rather than an absolute host. Publishing the two containers on two
# ports therefore does not work: the dashboard on :3002 would send every API
# call to itself. One origin has to cover both, which is what this does, and
# what the Traefik overlay does with two routers in production.
:80 {
	encode zstd gzip

	# Block form is load-bearing. Caddy's parser consumes the directive name
	# and then reads only a block, so the inline `request_body max_size 10MB`
	# spelling adapts without error and silently drops the limit - the emitted
	# JSON is a bare {"handler": "request_body"} with no max_size at all.
	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy backend:3001
	}

	# OAuth/OIDC discovery documents for MCP clients (RFC 8414/9728) are served
	# by the backend but must live at the domain root.
	handle /.well-known/oauth-* {
		reverse_proxy backend:3001
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy client:3002
	}
}

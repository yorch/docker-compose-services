# Every secret below is declared with `:?` in the compose files, so an unfilled
# copy of this file stops the stack with a message naming the variable rather
# than starting an analytics database on a guessable password.

# The public origin the dashboard is reached on, with no trailing slash. This
# is the backend's own idea of where it lives: invite links, the OAuth
# discovery documents and - the one that bites - the list of origins it will
# accept requests from. Set it to anything other than the address you actually
# open and the dashboard loads, then has every call it makes rejected as an
# untrusted cross-origin request.
#
#   Dev:     BASE_URL=http://localhost:3002
#   Traefik: BASE_URL=https://rybbit.example.com   (same host as DOMAIN below)
#
# In both cases this is the address a browser opens, not the backend's own
# port. The dashboard and the API always share one origin - Caddy provides it
# in dev, Traefik in production - and BASE_URL names that origin.
BASE_URL=

# Signs session cookies. Changing it logs everyone out.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Passwords for the three datastores. Nothing publishes their ports in the
# Traefik setup, but the dev overlay does not either - these guard containers
# that hold every event you collect.
#   openssl rand -hex 16
CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Traefik overlay only: the hostname Rybbit answers on. Must be the same host
# as BASE_URL.
DOMAIN=rybbit.example.com

# --- Optional ---------------------------------------------------------------

# Database and user names. Changing these after the first start does not
# rename anything that already exists - the stack comes up against an empty
# database instead.
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
POSTGRES_DB=analytics
POSTGRES_USER=rybbit

# Pin the Rybbit images instead of tracking latest.
IMAGE_TAG=latest

# Close registration once your own account exists. The first account created
# on a fresh install becomes the owner, so leave this false until you have
# signed up, then set it to true and restart.
DISABLE_SIGNUP=false

# Rybbit reports anonymous usage back to the project. Set true to opt out.
DISABLE_TELEMETRY=false

# Number of backend worker processes. Roughly one per CPU core.
CLUSTER_WORKERS=4

# Strips the dashboard down to a single overview page.
LITE_DASHBOARD=false

# Mapbox token. Only the 3D globe view needs it - the country, region and city
# maps and every other report work without one. The backend hands this to the
# dashboard at runtime, so setting it here is enough.
MAPBOX_TOKEN=

# OpenRouter credentials for the AI-generated report summaries. Both are
# needed for the feature to appear.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

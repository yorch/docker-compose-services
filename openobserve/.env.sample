# Values left blank below have no safe default. The compose file declares them
# required, so `docker compose up` stops with a message naming the variable
# rather than starting a half-configured instance.

# Traefik
DOMAIN=openobserve.example.com

# Initial admin login, created on first start.
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=

# Metadata store - users, dashboards, alerts and stream schemas.
# The password goes into a connection URL, so it must be URL-safe. A / or @ in
# it truncates the URL and OpenObserve exits with Configuration(InvalidPort).
# Generate with: openssl rand -hex 32
POSTGRES_DB=openobserve
POSTGRES_USER=openobserve
POSTGRES_PASSWORD=

# Where ingested data is stored. Leave as disk to keep everything under
# ./data/app. Every ZO_S3_* value below is ignored while this is disk.
ZO_LOCAL_MODE_STORAGE=disk

# Object storage, used only when ZO_LOCAL_MODE_STORAGE=s3.
# ZO_S3_PROVIDER accepts s3 (the default), aws, gcs, gcp, oss, minio or swift.
# Leave ZO_S3_SERVER_URL empty for AWS S3; set it for MinIO or GCS.
ZO_S3_PROVIDER=s3
ZO_S3_SERVER_URL=
ZO_S3_REGION_NAME=
ZO_S3_BUCKET_NAME=
ZO_S3_ACCESS_KEY=
ZO_S3_SECRET_KEY=

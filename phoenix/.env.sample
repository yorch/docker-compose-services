# POSTGRES_PASSWORD has no safe default. The compose file declares it required,
# so `docker compose up` stops with a message naming the variable rather than
# starting a half-configured instance. Everything else below is optional.
#
# The three commented-out settings must stay commented out until you give them
# a real value. Phoenix treats an empty string as an invalid value rather than
# as "unset", so PHOENIX_SECRET= on its own line stops the container from
# starting at all.

# Traefik
DOMAIN=phoenix.example.com

# Postgres, where traces, spans, datasets and experiments are stored. The same
# three values configure both containers. Phoenix percent-encodes them itself
# when it builds the connection string, so an @ in the password is safe.
# Generate one with: openssl rand -hex 32
POSTGRES_DB=phoenix
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=

# Authentication. Off by default, which leaves the UI, the REST/GraphQL APIs
# and both OTLP collectors open to anyone who can reach them - fine on a
# laptop, not on a public hostname.
PHOENIX_ENABLE_AUTH=false

# Required once PHOENIX_ENABLE_AUTH is true. Signs access and refresh tokens.
# Uncomment and fill in together with PHOENIX_ENABLE_AUTH=true.
# Generate one with: openssl rand -hex 32
# PHOENIX_SECRET=

# Password for the admin@localhost account Phoenix creates on its first start
# with auth enabled. Read only on that first start - changing it later does
# nothing, change the password in the UI instead. Defaults to "admin".
# PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=

# Comma-separated origins allowed to submit authenticated requests. Set it to
# your public URL when running behind Traefik with auth enabled, otherwise
# logins are rejected as cross-origin.
# PHOENIX_CSRF_TRUSTED_ORIGINS=https://phoenix.example.com

# Store auth tokens in secure cookies rather than local storage. Secure cookies
# are only sent over HTTPS, so leave this false for the dev overlay and turn it
# on behind Traefik.
PHOENIX_USE_SECURE_COOKIES=false

# Days to keep traces before they are deleted. 0 keeps them forever, which
# grows ./data/phoenix without bound.
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=0

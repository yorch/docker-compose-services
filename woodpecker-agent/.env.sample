# Values left blank below have no safe default. The compose file declares them
# required, so `docker compose up` stops with a message naming the variable
# rather than starting an agent that cannot connect.

# The server's gRPC endpoint - host and port, no scheme.
# Behind a reverse proxy terminating TLS this is normally port 443:
#   ci.example.com:443
# On a private network reaching the server container directly, it is port 9000:
#   10.0.0.5:9000
WOODPECKER_SERVER=

# Must be byte-identical to WOODPECKER_AGENT_SECRET on the server, or the
# agent connects and is rejected.
WOODPECKER_AGENT_SECRET=

# TLS for the gRPC connection. Leave both true whenever the agent reaches the
# server over the public internet.
# Set GRPC_SECURE=false only on a trusted private network or VPN, where the
# server exposes plain gRPC on 9000.
WOODPECKER_GRPC_SECURE=true
# Verify the server's certificate. Only meaningful when GRPC_SECURE is true.
# Set false only for a self-signed certificate you cannot add to the trust store.
WOODPECKER_GRPC_VERIFY=true

# Workflows this agent runs concurrently. Raise it to add capacity.
WOODPECKER_MAX_WORKFLOWS=1

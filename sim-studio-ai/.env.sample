DOMAIN=simstudio.example.com

# Public URL of the app. Use http://localhost:3000 for the dev overlay.
NEXT_PUBLIC_APP_URL=https://simstudio.example.com

# simstudio, realtime, migrations and cron images move together.
# SIM_VERSION=v0.9.3

# Database (Required)
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=simstudio

# Secrets (Required). Generate each with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Cannot be changed later without losing stored credentials
ENCRYPTION_KEY=
# Shared between simstudio and realtime
INTERNAL_API_SECRET=

# Scheduled workflows (Optional). Without it the cron service exits and
# schedules never fire. Generate with: openssl rand -hex 32
CRON_SECRET=

# Email Provider (Optional)
# Add your key from https://resend.com to send actual emails.
# If left empty, emails are logged to the console instead.
RESEND_API_KEY=

FREESTYLE_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OLLAMA_URL=http://localhost:11434
# TZ=UTC

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

# Public URL of the Lychee instance (scheme + host, no trailing slash)
APP_URL=https://lychee.example.com

# Laravel APP_KEY — generate with:
#   echo "APP_KEY=base64:$(openssl rand -base64 32)"
APP_KEY=

# Domain used by the Traefik overlay Host() rule
LYCHEE_DOMAIN=lychee.example.com

POSTGRES_DB=lychee
POSTGRES_USER=lychee
POSTGRES_PASSWORD=

TIMEZONE=UTC
# TIMEZONE=America/New_York

# Optional — defaults shown
# PUID=1000
# PGID=1000
# APP_NAME=Lychee
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=file
# SESSION_LIFETIME=120
# CACHE_STORE=file
# QUEUE_CONNECTION=database

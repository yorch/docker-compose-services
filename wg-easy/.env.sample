# Hostname Traefik serves the web UI on
DOMAIN=wg-easy.example.com

# Public hostname or IP that VPN clients connect to (UDP 51820)
WG_HOST=vpn.example.com

# Admin account created on the first start (unattended setup). Required.
# wg-easy does not check complexity; use a long password.
# Generate with: openssl rand -hex 16
WG_EASY_USERNAME=admin
WG_EASY_PASSWORD=

# Host interface for the dev overlay's web UI (loopback by default)
DEV_BIND_IP=127.0.0.1

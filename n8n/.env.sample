DOMAIN=n8n.example.com
DOMAIN_ADMINER=adminer-n8n.example.com
DOMAIN_REDISINSIGHT=redisinsight-n8n.example.com

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n

NODE_ENV=production

# n8n
N8N_HOST=${DOMAIN}
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your-encryption-key-here
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_AUTH_TOKEN=your-secret-here
WEBHOOK_URL=https://${DOMAIN}/

QUEUE_HEALTH_CHECK_ACTIVE=true

GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

WATCHTOWER_SCOPE=n8n

# n8n Assistant sandbox (opt-in, see README). These three sandbox service images
# ship as one release and must stay in step, so they share a single version.
N8N_SANDBOX_VERSION=1.5.0

# Sandbox service secrets. Generate each with: openssl rand -hex 32
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
# How n8n authenticates to the sandbox. Must match one value in SANDBOX_API_KEYS.
N8N_SANDBOX_SERVICE_API_KEY=

# Web-search backend for n8n Assistant. Generate with: openssl rand -hex 32
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# n8n Assistant itself. Off unless N8N_ENABLED_MODULES=instance-ai and a model is
# set; everything below is inert until then.
N8N_ENABLED_MODULES=
N8N_INSTANCE_AI_MODEL=
N8N_INSTANCE_AI_MODEL_API_KEY=
N8N_INSTANCE_AI_SANDBOX_ENABLED=false
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080

# Basic Auth for Traefik Middleware
BASIC_AUTH_USER=n8n
# pass: 12345
# Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Docker Compose 2.9+ requires that values with $ to be single quoted
BASIC_AUTH_PASSWORD_HASH='$apr1$l8szcj92$MV6AQHFFDqoDlOP9YYF3O1'

# Host interface the dev overlay publishes its datastore and admin-UI
# ports on. The default keeps them on the loopback address, reachable
# from this machine only. Set it to 0.0.0.0 to reach them from another
# machine - and note that Docker's own iptables rules sit in front of
# most host firewalls, so that really does mean the whole network.
DEV_BIND_IP=127.0.0.1

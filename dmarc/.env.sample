# Mailbox that receives the DMARC aggregate reports. The domain's DMARC record
# decides the address, for example:
#   _dmarc.example.com TXT "v=DMARC1; p=none; rua=mailto:dmarc@example.com"
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=dmarc@example.com
# Third-party credential: left blank on purpose, fill it in yourself.
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# How often to poll, in seconds. 86400 = daily, which matches how often
# receivers send reports. Minimum 60.
DMARC_INTERVAL_SECONDS=86400

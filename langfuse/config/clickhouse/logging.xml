<clickhouse>
  <logger>
    <level>warning</level>
    <console>true</console>
  </logger>
  <!-- Langfuse's own ClickHouse usage is small - a few hundred rows in a fresh
       install - so the stock defaults are almost all overhead here. The server
       logs at trace level into system.text_log and writes profiler spans for
       its own background merges into system.trace_log, at 30-day TTLs. Those
       writes are merges too, whose progress is logged again, so the tables feed
       their own merge queue. Once they outgrow the container's memory limit the
       merges fail with MEMORY_LIMIT_EXCEEDED and are retried indefinitely:
       observed at 512% CPU and 49 GiB on disk against 292 rows of real data.
       Same treatment as rybbit/ and plausible-analytics/. -->
  <query_thread_log remove="remove" />
  <query_log remove="remove" />
  <query_views_log remove="remove" />
  <query_metric_log remove="remove" />
  <error_log remove="remove" />
  <opentelemetry_span_log remove="remove" />
  <text_log remove="remove" />
  <trace_log remove="remove" />
  <metric_log remove="remove" />
  <asynchronous_metric_log remove="remove" />
  <session_log remove="remove" />
  <part_log remove="remove" />
  <latency_log remove="remove" />
  <processors_profile_log remove="remove" />
</clickhouse>

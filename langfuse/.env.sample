# Secrets below are declared with `:?` in the compose files, so an unfilled
# copy of this file stops the stack with a message naming the variable rather
# than starting on a guessable password.

# --- Addresses ---------------------------------------------------------------

# The public origin of the Langfuse UI, no trailing slash. NextAuth builds
# callback URLs from it, so a wrong value produces a login that redirects
# somewhere unreachable.
#   Dev:     NEXTAUTH_URL=http://localhost:3000
#   Traefik: NEXTAUTH_URL=https://langfuse.example.com
NEXTAUTH_URL=

# Where a BROWSER can reach the S3 API. Langfuse signs media URLs with this
# host and hands them to the browser, so it cannot be the internal
# http://seaweedfs:8333 - that name does not resolve outside the compose
# network, and uploaded images silently fail to load.
#   Dev:     S3_PUBLIC_URL=http://localhost:8333
#   Traefik: S3_PUBLIC_URL=https://s3.langfuse.example.com  (same as S3_DOMAIN)
S3_PUBLIC_URL=

# Traefik overlay only. DOMAIN serves the UI, S3_DOMAIN serves the S3 API.
# They must be two different hostnames, both pointing at this host.
DOMAIN=langfuse.example.com
S3_DOMAIN=s3.langfuse.example.com

# --- Secrets -----------------------------------------------------------------

# Hashes API keys. Changing it invalidates every existing key.
#   openssl rand -base64 32
SALT=

# Encrypts stored LLM API keys and integration credentials. Must be exactly 64
# hex characters - Langfuse refuses to start otherwise. Changing it makes
# everything already encrypted unreadable.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Signs session cookies. Changing it logs everyone out.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Datastore passwords.
#   openssl rand -hex 16
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
# Secret key for object storage.
S3_SECRET_KEY=

# --- Databases ---------------------------------------------------------------

POSTGRES_DB=langfuse
POSTGRES_USER=langfuse

# Must match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above. Compose
# does not assemble it for you. Left blank on purpose: the `:?` guard only
# fires on an EMPTY value, so shipping a placeholder here would sail past it
# and fail later as a database authentication error instead of a named one at
# startup. ./setup.sh fills it in to match the password it generates.
#   postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=

CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse

# Object storage identity. SeaweedFS is configured with exactly this one
# identity, granted Admin on the bucket below.
S3_ACCESS_KEY=langfuse
S3_BUCKET_NAME=langfuse

# --- Optional ----------------------------------------------------------------

# Langfuse image tag. `4` tracks the current major; pin a full version to hold
# still. Moving between majors is not just a retag - see the README.
LANGFUSE_VERSION=4

# Host interface the dev overlay publishes its sidecar ports on. The default
# keeps ClickHouse, Redis, Postgres, the worker and the SeaweedFS master UI on
# the loopback address. The Langfuse UI and the S3 API are always published on
# all interfaces, because a browser has to reach them.
DEV_BIND_IP=127.0.0.1

# Where Langfuse looks for ClickHouse and Redis. The defaults point at the
# containers in this stack; change them only to use a datastore you run
# elsewhere. ClickHouse needs both: migrations go over the native protocol on
# 9000, queries over HTTP on 8123.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# Langfuse reports anonymous usage back to the project. Set false to opt out.
TELEMETRY_ENABLED=true

# Unreleased features. Off by default for a reason.
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# Sending user invitations needs both of these.
#   SMTP_CONNECTION_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=

# Bootstrap an organisation, project, API keys and first user on an EMPTY
# database. Leave blank to use the normal sign-up screen instead. Only read on
# first start against a fresh Postgres volume.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

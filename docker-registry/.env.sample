REGISTRY_DOMAIN=cr.example.com
REGISTRY_UI_DOMAIN=cr-ui.example.com

REGISTRY_PORT=5000

REGISTRY_STORAGE_S3_ACCESSKEY=
REGISTRY_STORAGE_S3_SECRETKEY=
REGISTRY_STORAGE_S3_BUCKET=
REGISTRY_STORAGE_S3_REGION=

# REGISTRY_HTTP_TLS_LETSENCRYPT_EMAIL=
# REGISTRY_HTTP_TLS_LETSENCRYPT_HOST=

REDIS_PASSWORD=

# Scheduled maintenance (opt-in overlay docker-compose.maintenance.yml, started by ./run-with-maintenance.sh)
# Absolute path of this folder on the host; run-with-maintenance.sh sets it for you.
# MAINTENANCE_PROJECT_DIR=
# Nothing is deleted until this is false: jobs only log what they would delete.
MAINTENANCE_DRY_RUN=true
# Weekly audit and cleanup, as '<Mon|Tue|Wed|Thu|Fri|Sat|Sun> HH:MM' in the server's time zone.
MAINTENANCE_WEEKLY_AT='Mon 06:00'
# Monthly garbage collection (the registry is read-only for a couple of hours), as
# 'first-<day> HH:MM', or 'off' to never run it.
MAINTENANCE_GC_AT='first-Sun 03:00'
# Repositories without tags are only removed once nothing has touched them for this many hours, so a
# first push that is still in progress is left alone.
MAINTENANCE_MIN_AGE_HOURS=24
# Tag retention: keep the newest N tags of each repository (0 = off). Tags matching
# MAINTENANCE_PROTECTED_TAGS (comma-separated patterns) are never removed and do not count towards N.
MAINTENANCE_KEEP_TAGS=0
MAINTENANCE_PROTECTED_TAGS='latest,main,v*'
# Job logs older than this are deleted (they are in ./data/maintenance/logs/).
MAINTENANCE_LOG_RETENTION_DAYS=90
# Time zone for the schedule when it should differ from the server's, e.g. America/New_York.
MAINTENANCE_TZ=

DOMAIN=siglens.domain.com

# Basic auth in front of the UI behind Traefik (required there). Generate the hash:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Hashes contain $, so keep the value single-quoted.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD_HASH=

# Only used by docker-compose.dev.yml, which publishes these on the host.
# Behind Traefik the UI is proxied and neither port is published.
INGEST_PORT=8081
UI_PORT=5122

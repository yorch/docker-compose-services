# Required. Password for the `postgres` user. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# pgAdmin (dev overlay, `--profile pgadmin`). The password is required
# whenever the dev overlay is used. Generate with: openssl rand -hex 16
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Host interface for pgAdmin in the dev overlay (loopback by default)
DEV_BIND_IP=127.0.0.1

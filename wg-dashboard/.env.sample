DOMAIN=wg-dashboard.example.com

# Web account (the image otherwise accepts admin/admin). Password required.
# Generate with: openssl rand -hex 16
WGD_USERNAME=admin
WGD_PASSWORD=

# Public IP written into client configs; detected automatically when empty
# PUBLIC_IP=

# Default DNS for WireGuard clients
GLOBAL_DNS=1.1.1.1

# Web app port (container, and host port in the dev overlay)
PORT_WEB=10086

# TZ=Etc/UTC

# Host interface for the dev overlay's web UI (loopback by default)
DEV_BIND_IP=127.0.0.1

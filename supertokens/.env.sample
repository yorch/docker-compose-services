DOMAIN=supertokens.domain.com

# Required. Key your backend SDK uses to call the core (apiKey in
# SuperTokens.init). Letters, digits, = and - only, at least 20 characters.
# Generate with: openssl rand -hex 32
SUPERTOKENS_API_KEY=

# Database
POSTGRES_DB=supertokens
POSTGRES_USER=supertokens
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Host interface the dev overlay publishes the core on (loopback by default)
DEV_BIND_IP=127.0.0.1

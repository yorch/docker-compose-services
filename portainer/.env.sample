HOST=portainer.domain.com

# Basic auth in front of Portainer behind Traefik (required there). Generate the hash:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Hashes contain $, so keep the value single-quoted.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD_HASH=

# Host interface for the dev port (loopback by default)
DEV_BIND_IP=127.0.0.1

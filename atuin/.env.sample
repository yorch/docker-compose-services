# Values left blank below have no safe default. The compose file declares them
# required, so `docker compose up` stops with a message naming the variable
# rather than starting a half-configured instance.

# Traefik
DOMAIN=atuin.example.com

# Allow new accounts to register. Set to true only while registering your own
# account(s), then back to false and recreate the container.
ATUIN_OPEN_REGISTRATION=false

# Server log level (RUST_LOG syntax), e.g. info,atuin_server=debug
RUST_LOG=atuin_server=info

POSTGRES_DB=atuin
POSTGRES_USER=atuin
# Stick to [A-Za-z0-9.~_-] - the password is embedded in a URI unescaped.
# Generate with openssl rand -hex 24
POSTGRES_PASSWORD=

# Dev overlay only - interface the Postgres port binds to. Leave blank for
# localhost; set 0.0.0.0 to expose it on every interface (not recommended).
DEV_BIND_IP=

TRAEFIK_HOST=traefik.yourdomain.com

ACME_EMAIL=youremail@domain.com

# Traefik log verbosity: DEBUG, INFO, WARN, ERROR (defaults to INFO)
# TRAEFIK_LOG_LEVEL=INFO

# Dashboard basic auth (required). Generate the hash with
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' | cut -d: -f2
# Hashes contain $, so keep the value single-quoted or compose will interpolate it.
DASHBOARD_USERNAME=
DASHBOARD_HASHED_PASSWORD=

# LetsEncrypt (DNS Challenge)
# DO_AUTH_TOKEN=

# InfluxDB v2
# INFLUXDB2_URL=http://influxdb:8086
# INFLUXDB2_TOKEN=
# INFLUXDB2_ORG=
# INFLUXDB2_BUCKET=
